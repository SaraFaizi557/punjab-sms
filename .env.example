# ── Local development ─────────────────────────────────────────────────────────
# Copy to .env.local then restart: npm run dev
#
# ── Vercel (required for worldwide Cloud) ─────────────────────────────────────
# Project → Settings → Environment Variables → add BOTH for Production + Preview:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
# Then Redeploy. Without these, Cloud stays OFF on the live site.
#
# Get values from: Supabase → Project Settings → API
#   Project URL  → VITE_SUPABASE_URL
#   anon public  → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Paper Generator → AI Book Paper. Server-side only. Do not prefix with VITE_.
# Get a key from Google AI Studio, add it here, then restart npm run dev.
# On Vercel, add the same name under Project → Settings → Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash 
